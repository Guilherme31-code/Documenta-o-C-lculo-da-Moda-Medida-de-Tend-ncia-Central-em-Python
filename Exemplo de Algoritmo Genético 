        "import random\n",
        "\n",
        "def fitness(x):\n",
        "    return x**2  # função de avaliação simples\n",
        "\n",
        "def mutate(x):\n",
        "    return x + random.uniform(-1, 1)\n",
        "\n",
        "def crossover(a, b):\n",
        "    return (a+b)/2\n",
        "\n",
        "# Inicialização\n",
        "population = [random.uniform(-10, 10) for _ in range(10)]\n",
        "\n",
        "for generation in range(100):\n",
        "    population = sorted(population, key=fitness, reverse=True)\n",
        "    new_pop = population[:2]  # elitismo\n",
        "    while len(new_pop) < 10:\n",
        "        parents = random.sample(population[:5], 2)\n",
        "        child = crossover(parents[0], parents[1])\n",
        "        child = mutate(child)\n",
        "        new_pop.append(child)\n",
        "    population = new_pop\n",
        "\n",
        "print(\"Melhor solução:\", max(population, key=fitness))\n"
      ]
    }
