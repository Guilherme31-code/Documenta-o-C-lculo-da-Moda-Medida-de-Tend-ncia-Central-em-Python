        "def cadastrar_usuarios(usuarios):\n",
        "  nome = input(\"Digite o nome de usuário:\")\n",
        "  if nome in usuarios:\n",
        "    print(\"Usuário ja existe.\")\n",
        "    return\n",
        "  senha = input(\"Digite a senha:\")\n",
        "  usuarios[nome] = senha\n",
