        "#Função para carregar usuários de um arquivo"
      ],
      "metadata": {
        "id": "5uoATLUlFWZb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def carregar_usuarios():\n",
        "  try:\n",
        "    with open(\"usuarios.txt\", \"r\") as arquivo:\n",
        "      usuarios = {}\n",
        "      for linha in arquivo:\n",
        "        nome, senha = linha.strip().split(\",\")\n",
        "        usuarios[nome] = senha\n",
        "      return usuarios\n",
        "  except FileNotFoundError:\n",
        "    return {}"
      ],
